# Copy to .env and fill in for local development. Never commit the real .env.
# See src/central_governance_api/config.py for full field docs.

CGA_DATABASE_URL=postgresql+asyncpg://cga:CHANGE_ME@localhost:5432/central_governance

CGA_OIDC_ISSUER=https://keycloak.example.invalid/realms/roy-governance
CGA_OIDC_JWKS_URL=https://keycloak.example.invalid/realms/roy-governance/protocol/openid-connect/certs
CGA_OIDC_AUDIENCE=central-governance-api

# Set to false ONLY against the known local-dev Keycloak instance that
# currently runs http-enabled=true (see Phase 0 wiki notes) — never for a
# real deployment.
# CGA_OIDC_REQUIRE_HTTPS=false
